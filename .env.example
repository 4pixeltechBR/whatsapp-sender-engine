# WhatsApp Sender Engine — Environment Variables Example
# Copy this file to .env and adjust as needed:

# Host and Port for local web server
WSE_HOST=127.0.0.1
WSE_PORT=8765

# Debug mode (true/false)
WSE_DEBUG=false

# Anti-Ban Jitter Defaults (seconds)
WSE_DEFAULT_JITTER_MIN=10.0
WSE_DEFAULT_JITTER_MAX=25.0

# Batch Pause Defaults
WSE_BATCH_SIZE=20
WSE_BATCH_PAUSE_SECONDS=120.0
